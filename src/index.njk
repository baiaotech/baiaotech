---
layout: layouts/base.njk
title: Agenda tech
description: Descubra eventos e comunidades que movimentam a tecnologia no Nordeste.
bodyClass: page-home
---
{% set upcomingEvents = collections.eventsFuture %}
{% set featuredCommunities = collections.featuredCommunities %}
{% set heroEvent = upcomingEvents[0] or collections.eventsSorted[0] %}
{% set agendaEvents = upcomingEvents.slice(0, 3) %}
{% set heroEventSpansMonths = heroEvent.data.start_date | eventSpansMonths(heroEvent.data.end_date) %}

<section class="hero-home" data-hero>
  <picture class="hero-home__picture">
    <source media="(max-width: 720px)" srcset="{{ '/assets/editorial/hero-pulse-mobile.webp' | url }}">
    <img class="hero-home__art" src="{{ '/assets/editorial/hero-pulse.webp' | url }}" alt="" width="1600" height="600" decoding="async" fetchpriority="high">
  </picture>

  <div class="container hero-home__inner">
    <div class="hero-home__copy" data-reveal>
      <p class="eyebrow eyebrow--light">Agenda aberta do Nordeste</p>
      <h1>O próximo encontro tech começa por aqui.</h1>

      <form class="hero-search" action="{{ '/eventos/' | url }}" method="get" role="search">
        <label class="sr-only" for="home-search">Buscar eventos</label>
        <input id="home-search" name="q" type="search" placeholder="Busque por evento, cidade ou tema">
        <button type="submit">Buscar</button>
      </form>

      <nav class="hero-quick-links" aria-label="Atalhos da agenda">
        <a href="{{ '/eventos/' | url }}?state=PI">Piauí</a>
        <a href="{{ '/eventos/' | url }}?state=CE">Ceará</a>
        <a href="{{ '/eventos/' | url }}?state=PE">Pernambuco</a>
        <a href="{{ '/eventos/' | url }}?categories=ia">Inteligência Artificial</a>
      </nav>
    </div>

    <aside class="hero-stats" aria-label="Cobertura do Baião Tech" data-reveal>
      <p><strong>{{ upcomingEvents.length }}</strong><span>eventos</span></p>
      <p><strong>{{ collections.communitiesSorted.length }}</strong><span>comunidades</span></p>
      <small>Tecnologia que movimenta o Nordeste.</small>
    </aside>
  </div>
</section>

<section class="home-agenda" aria-labelledby="agenda-title">
  <div class="container home-agenda__grid">
    <div class="home-agenda__main">
      <header class="section-heading">
        <div>
          <p class="eyebrow">Agenda</p>
          <h2 id="agenda-title">Acontece agora</h2>
        </div>
        <a class="arrow-link" href="{{ '/eventos/' | url }}">Ver agenda completa</a>
      </header>

      <div class="listing-list listing-list--home">
        {% set eventCardContext = 'home' %}
        {% for event in agendaEvents %}
          {% include "partials/event-card.njk" %}
        {% endfor %}
      </div>
    </div>

    {% if heroEvent %}
      {% set heroCategoryLabels = heroEvent.data.page.inputPath | eventCategoryLabels(categoriesBySlug) %}
      <aside class="agenda-spotlight" data-reveal>
        <p class="eyebrow">Próximo evento</p>
        <h2>{{ heroEvent.data.title }}</h2>
        <p class="agenda-spotlight__meta">
          <strong>{{ heroEvent.data.start_date | eventDayRange(heroEvent.data.end_date) }}{% if not heroEventSpansMonths %} {{ heroEvent.data.start_date | monthShort }}{% endif %}</strong>
          · {{ heroEvent.data.city }}, {{ heroEvent.data.state | stateName }}
        </p>
        <p class="agenda-spotlight__summary">{{ heroEvent.templateContent | summaryText }}</p>
        {% if heroCategoryLabels.length %}
          <ul class="tag-list" aria-label="Categorias">
            {% for categoryLabel in heroCategoryLabels.slice(0, 2) %}<li>{{ categoryLabel }}</li>{% endfor %}
          </ul>
        {% endif %}
        <a class="button button--primary button--wide" href="{{ heroEvent.url | url }}">Ver detalhes do evento</a>

        <div class="agenda-spotlight__communities">
          <strong>{{ collections.communitiesSorted.length }} comunidades</strong>
          <span>Pessoas que constroem tecnologia no Nordeste.</span>
          <a class="button button--secondary button--wide" href="{{ '/comunidades/' | url }}">Explorar comunidades</a>
        </div>
      </aside>
    {% endif %}
  </div>
</section>

<section class="home-communities" aria-labelledby="communities-title">
  <div class="container">
    <header class="section-heading home-communities__heading">
      <div>
        <p class="eyebrow">Rede local</p>
        <h2 id="communities-title">Comunidades para conhecer</h2>
        <p>Grupos que compartilham conhecimento e conectam pessoas em toda a região.</p>
      </div>
      <a class="arrow-link" href="{{ '/comunidades/' | url }}">Explorar comunidades</a>
    </header>

    <div class="community-grid community-grid--home">
      {% set communityCardContext = 'home' %}
      {% for community in featuredCommunities.slice(0, 3) %}
        {% include "partials/community-card.njk" %}
      {% endfor %}
    </div>
  </div>
</section>
