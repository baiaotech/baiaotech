---
layout: layouts/base.njk
title: Eventos
description: Agenda filtrável de eventos de tecnologia do Nordeste.
bodyClass: page-events
pageScripts:
  - /assets/js/list-filters.js
---
{% set futureEvents = collections.eventsFuture %}
{% set pastEvents = collections.eventsPast %}
{% set allEvents = collections.eventsSorted %}
{% set monthOptions = allEvents | eventMonths %}
{% set stateOptions = allEvents | uniqueStates %}

<section class="utility-intro">
  <div class="container utility-intro__inner" data-reveal>
    <p class="eyebrow eyebrow--light">Agenda do Nordeste</p>
    <h1>Encontre seu próximo encontro tech.</h1>
    <p>Pesquise por tema, cidade ou organização e refine a agenda em tempo real.</p>
  </div>
</section>

<section class="listing-shell" data-list-root>
  <div class="container listing-shell__toolbar" data-reveal>
    <div>
      <p class="eyebrow">Agenda aberta</p>
      <h2 aria-live="polite" aria-atomic="true"><span data-results-count>{{ allEvents.length }}</span> eventos encontrados</h2>
    </div>
    <button class="filter-toggle" type="button" data-filter-toggle aria-expanded="false" aria-controls="event-filters">Abrir filtros</button>
  </div>

  <div class="container filter-status" data-filter-status hidden>
    <div class="filter-status__chips" data-filter-chips aria-live="polite"></div>
    <button class="text-link text-link--touch" type="button" data-filter-reset>Limpar filtros</button>
  </div>

  <div class="filter-backdrop" data-filter-backdrop hidden></div>

  <div class="container listing-shell__layout">
    <aside class="filter-panel" id="event-filters" data-filter-panel aria-label="Filtros de eventos">
      <div class="filter-panel__header">
        <div>
          <p class="eyebrow">Refine a busca</p>
          <h3>Filtros</h3>
        </div>
        <button class="filter-panel__close" type="button" data-filter-close>Fechar</button>
      </div>

      <form class="filter-form" aria-label="Filtros de eventos" data-filter-form>
        <label class="filter-form__search">
          <span>Buscar</span>
          <input name="q" type="search" placeholder="Evento, cidade ou tema" autocomplete="off" data-filter-search>
        </label>
        <label>
          <span>Tipo</span>
          <select name="kind" data-filter-key="kind">
            <option value="">Todos</option>
            {% for item in eventMeta.kinds %}<option value="{{ item.value }}">{{ item.label }}</option>{% endfor %}
          </select>
        </label>
        <label>
          <span>Categoria</span>
          <select name="categories" data-filter-key="categories">
            <option value="">Todas</option>
            {% for category in categories %}<option value="{{ category.slug }}">{{ category.name }}</option>{% endfor %}
          </select>
        </label>
        <label>
          <span>Formato</span>
          <select name="format" data-filter-key="format">
            <option value="">Todos</option>
            {% for item in eventMeta.formats %}<option value="{{ item.value }}">{{ item.label }}</option>{% endfor %}
          </select>
        </label>
        <label>
          <span>Estado</span>
          <select name="state" data-filter-key="state">
            <option value="">Todos</option>
            {% for state in stateOptions %}<option value="{{ state }}">{{ state | stateName }}</option>{% endfor %}
          </select>
        </label>
        <label>
          <span>Mês</span>
          <select name="month" data-filter-key="month">
            <option value="">Todos</option>
            {% for month in monthOptions %}<option value="{{ month.value }}">{{ month.label }}</option>{% endfor %}
          </select>
        </label>
        <div class="filter-actions">
          <button class="button button--primary" type="submit">Aplicar filtros</button>
          <button class="button button--ghost" type="button" data-filter-reset>Limpar</button>
        </div>
      </form>
    </aside>

    <div class="listing-shell__content">
      <section class="listing-block" data-filter-section>
        <header class="listing-block__header">
          <div>
            <p class="eyebrow">No radar</p>
            <h2>Próximos eventos</h2>
          </div>
          <p><span data-section-count>{{ futureEvents.length }}</span> na agenda</p>
        </header>
        <div class="listing-list">
          {% for event in futureEvents %}{% include "partials/event-card.njk" %}{% endfor %}
        </div>
        <p class="empty-inline" data-section-empty hidden>Nenhum próximo evento combina com os filtros.</p>
      </section>

      {% if pastEvents.length %}
        <section class="listing-block listing-block--subdued" data-filter-section>
          <header class="listing-block__header">
            <div><p class="eyebrow">Memória</p><h2>Eventos anteriores</h2></div>
            <p><span data-section-count>{{ pastEvents.length }}</span> no arquivo</p>
          </header>
          <div class="listing-list">
            {% for event in pastEvents %}{% include "partials/event-card.njk" %}{% endfor %}
          </div>
          <p class="empty-inline" data-section-empty hidden>Nenhum evento anterior combina com os filtros.</p>
        </section>
      {% endif %}
    </div>
  </div>
</section>
