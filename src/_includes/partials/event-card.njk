{% set data = event.data %}
{% set isFuture = data.end_date | isFutureDate %}
{% set cover = data.page.inputPath | eventArtworkThumb %}
{% set categorySlugs = data.page.inputPath | eventCategorySlugs %}
{% set categoryLabels = data.page.inputPath | eventCategoryLabels(categoriesBySlug) %}
{% set spansMonths = data.start_date | eventSpansMonths(data.end_date) %}
<article
  class="listing-row listing-row--event listing-row--{{ eventCardContext or 'listing' }}"
  data-card
  data-searchable="{{ data.title }} {{ data.organizer }} {{ data.city }} {{ data.state | stateName }} {{ categoryLabels | join(' ') }}"
  data-kind="{{ data.kind }}"
  data-format="{{ data.format }}"
  data-state="{{ data.state }}"
  data-month="{{ data.start_date.slice(0, 7) }}"
  data-categories="{{ categorySlugs | join(',') }}"
  data-status="{{ 'future' if isFuture else 'past' }}"
>
  <time class="listing-row__date" datetime="{{ data.start_date }}">
    <span class="listing-row__day{{ ' listing-row__day--cross-month' if spansMonths }}">{{ data.start_date | eventDayRange(data.end_date) }}</span>
    {% if not spansMonths %}<span class="listing-row__month">{{ data.start_date | monthShort }}</span>{% endif %}
  </time>

  <div class="listing-row__media" aria-hidden="true">
    <img src="{{ cover }}" alt="" width="240" height="144" loading="lazy" decoding="async">
  </div>

  <div class="listing-row__body">
    <p class="listing-row__eyebrow">
      {{ data.kind | kindLabel }} · {{ data.format | formatLabel }}
    </p>
    <h3 class="listing-row__title">{{ data.title }}</h3>
    <p class="listing-row__summary">
      {{ data.city }}{% if data.city and data.state %}, {% endif %}{{ data.state | stateName }}
      {% if data.organizer %}<span> · {{ data.organizer }}</span>{% endif %}
    </p>

    {% if categoryLabels.length %}
      <ul class="listing-row__meta-list" aria-label="Categorias">
        {% for categoryLabel in categoryLabels.slice(0, 3) %}
          <li>{{ categoryLabel }}</li>
        {% endfor %}
      </ul>
    {% endif %}
  </div>

  <div class="listing-row__cta">
    {% if data.price %}
      <span class="listing-row__price">{{ data.price | priceLabel }}</span>
    {% endif %}
    <a class="text-link text-link--touch" href="{{ event.url | url }}" aria-label="Ver detalhes de {{ data.title }}">Detalhes</a>
  </div>
</article>
