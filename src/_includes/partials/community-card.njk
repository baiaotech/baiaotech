{% set data = community.data %}
{% set cover = data.cover_image | localAsset | displayImage %}
<article
  class="community-card community-card--{{ communityCardContext or 'listing' }}"
  data-card
  data-searchable="{{ data.title }} {{ data.state | stateName }} {{ data.city }} {{ data.tags | join(' ') }}"
  data-state="{{ data.state }}"
  data-tags="{{ data.tags | join(',') }}"
>
  <div class="community-card__identity">
    {% if cover %}
      <img src="{{ cover }}" alt="Logotipo de {{ data.title }}" width="160" height="96" loading="lazy" decoding="async">
    {% else %}
      <span aria-hidden="true">{{ data.state }}</span>
    {% endif %}
  </div>

  <div class="community-card__body">
    <p class="community-card__location">{{ data.state | stateName }}{% if data.city %} · {{ data.city }}{% endif %}</p>
    <h3><a href="{{ community.url | url }}">{{ data.title }}</a></h3>
    <p>{{ community.templateContent | summaryText }}</p>
    {% if data.tags.length %}
      <ul class="tag-list" aria-label="Temas">
        {% for tag in data.tags.slice(0, 3) %}
          <li>{{ tag | tagLabel }}</li>
        {% endfor %}
      </ul>
    {% endif %}
  </div>

</article>
