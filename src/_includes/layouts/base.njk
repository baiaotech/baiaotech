<!doctype html>
<html lang="{{ site.locale }}">
  <head>
    {% set metaDescription = description or (content | summaryText) or site.description %}
    {% set metaImage = (openGraphImage or cover_image or site.socialImage) | absoluteImage %}
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>{% if title %}{{ title }} · {{ site.title }}{% else %}{{ site.title }}{% endif %}</title>
    <meta name="description" content="{{ metaDescription }}">
    <meta name="theme-color" content="#2f4fda">
    <meta property="og:title" content="{% if title %}{{ title }} · {{ site.title }}{% else %}{{ site.title }}{% endif %}">
    <meta property="og:description" content="{{ metaDescription }}">
    <meta property="og:locale" content="{{ site.locale }}">
    <meta property="og:type" content="website">
    <meta property="og:url" content="{{ page.url | absoluteUrl }}">
    <meta property="og:image" content="{{ metaImage }}">
    <meta name="twitter:card" content="summary_large_image">
    <link rel="canonical" href="{{ page.url | absoluteUrl }}">
    <link rel="icon" type="image/png" href="{{ '/assets/favicon.png' | url }}">
    <link rel="apple-touch-icon" href="{{ '/assets/favicon.png' | url }}">
    <script>document.documentElement.classList.add("js");</script>
    <link rel="stylesheet" href="{{ '/assets/css/site.css' | url }}">
    {% block headExtra %}{% endblock %}
  </head>
  <body class="{{ bodyClass or '' }}">
    <a class="skip-link" href="#conteudo">Pular para o conteudo</a>

    <header class="site-header" data-site-header>
      <div class="container site-header__inner">
        <a class="site-brand" href="{{ '/' | url }}">
          <span class="site-brand__name">Baião Tech</span>
          <span class="site-brand__sub">eventos e comunidades</span>
        </a>

        <button class="site-nav-toggle" type="button" data-nav-toggle aria-expanded="false" aria-controls="site-nav">
          <span class="sr-only">Abrir menu</span>
          <span aria-hidden="true"></span>
          <span aria-hidden="true"></span>
          <span aria-hidden="true"></span>
        </button>

        <nav class="site-nav" id="site-nav" data-site-nav aria-label="Principal">
          {% set nav = [
            { "href": "/", "label": "Inicio" },
            { "href": "/eventos/", "label": "Eventos" },
            { "href": "/comunidades/", "label": "Comunidades" },
            { "href": "/como-contribuir/", "label": "Contribuir" }
          ] %}
          {% for item in nav %}
            <a href="{{ item.href | url }}" {% if page.url == item.href %}aria-current="page"{% endif %}>
              {{ item.label }}
            </a>
          {% endfor %}
        </nav>
        <div class="site-nav-backdrop" data-nav-backdrop hidden></div>
      </div>
    </header>

    <main id="conteudo">
      {% block content %}{{ content | safe }}{% endblock %}
    </main>

    <footer class="site-footer">
      <div class="container site-footer__inner">
        <div>
          <p class="eyebrow">Baião Tech</p>
          <p class="site-footer__summary">
            Acompanhe eventos e descubra comunidades de tecnologia em um só lugar.
          </p>
        </div>
        <div class="site-footer__links">
          <a href="{{ '/eventos/' | url }}">Eventos</a>
          <a href="{{ '/comunidades/' | url }}">Comunidades</a>
          <a href="{{ '/como-contribuir/' | url }}">Como contribuir</a>
        </div>
      </div>
    </footer>

    <script src="{{ '/assets/js/site.js' | url }}" defer></script>
    {% if pageScripts %}
      {% for scriptPath in pageScripts %}
        <script src="{{ scriptPath | url }}" defer></script>
      {% endfor %}
    {% endif %}
  </body>
</html>
